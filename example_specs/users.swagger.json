{
  "swagger": "2.0",
  "info": {
    "title": "Users",
    "version": "2.1.0",
    "description": "Swagger 2.0 example: converted to OpenAPI 3 on load. Responses without examples are synthesised from their schema."
  },
  "host": "users.example.com",
  "basePath": "/api",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "tags": [{ "name": "auth" }, { "name": "users" }],
  "paths": {
    "/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "summary": "Log in with a username and password",
        "parameters": [
          {
            "in": "body",
            "name": "credentials",
            "required": true,
            "schema": { "$ref": "#/definitions/Credentials" }
          }
        ],
        "responses": {
          "200": {
            "description": "Logged in",
            "schema": { "$ref": "#/definitions/Session" },
            "examples": { "application/json": { "token": "eyJhbGciOi.example.token", "expiresIn": 3600 } }
          },
          "401": {
            "description": "Wrong username or password",
            "schema": { "$ref": "#/definitions/Error" },
            "examples": { "application/json": { "code": "INVALID_CREDENTIALS", "message": "Username or password is incorrect" } }
          },
          "423": {
            "description": "Account locked",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["auth"],
        "summary": "End the session",
        "responses": { "204": { "description": "Logged out" } }
      }
    },
    "/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "tags": ["users"],
        "summary": "Fetch a user",
        "parameters": [{ "in": "path", "name": "userId", "required": true, "type": "string", "format": "uuid" }],
        "responses": {
          "200": { "description": "The user", "schema": { "$ref": "#/definitions/User" } },
          "404": { "description": "No such user", "schema": { "$ref": "#/definitions/Error" } }
        }
      }
    },
    "/users/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": ["users"],
        "summary": "The logged-in user (a static route that wins over /users/{userId})",
        "responses": {
          "200": { "description": "The user", "schema": { "$ref": "#/definitions/User" } }
        }
      }
    }
  },
  "definitions": {
    "Credentials": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string", "format": "password" }
      }
    },
    "Session": {
      "type": "object",
      "required": ["token"],
      "properties": {
        "token": { "type": "string" },
        "expiresIn": { "type": "integer" }
      }
    },
    "User": {
      "type": "object",
      "required": ["id", "email", "role"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "manager": { "$ref": "#/definitions/User" }
      }
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
