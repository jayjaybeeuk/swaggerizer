{
  "openapi": "3.0.1",
  "info": { "title": "Example BFF", "version": "1.0.0" },
  "servers": [{ "url": "https://EXAMPLE-BFF-DEV/v4", "description": "Generated server url" }],
  "paths": {
    "/banking/businesses/{businessId}/rewards": {
      "get": {
        "operationId": "getBusinessRewards",
        "parameters": [{ "name": "businessId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Rewards" } } } },
          "500": { "description": "Error", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/banking/businesses/{businessId}/transactions/search": {
      "post": {
        "operationId": "searchTransactions",
        "parameters": [{ "name": "businessId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "cursor": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "string" } }, "nextCursor": { "type": "string", "nullable": true } } } } } }
        }
      }
    },
    "/banking/businesses/{businessId}/expenses": {
      "get": {
        "operationId": "listExpenses",
        "parameters": [{ "name": "businessId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Expense" } } } } } }
      },
      "post": {
        "operationId": "createExpense",
        "parameters": [{ "name": "businessId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Expense" } } } },
        "responses": { "201": { "description": "Created", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Expense" } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "Rewards": {
        "type": "object",
        "properties": {
          "startDate": { "type": "string", "format": "date", "example": "2026-05-01" },
          "totals": { "type": "array", "items": { "type": "object", "properties": { "currency": { "type": "string", "example": "GBP" }, "cashback": { "type": "number", "example": 12.5 } } } }
        }
      },
      "Expense": { "type": "object", "properties": { "id": { "type": "string" }, "amount": { "type": "number" } } },
      "Error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
    }
  }
}
